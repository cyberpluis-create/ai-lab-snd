# ═══════════════════════════════════════════════════════════════
# AI LAB SND — ENVIRONMENT VARIABLES TEMPLATE
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the real `.env` file to Git!
# ═══════════════════════════════════════════════════════════════

# -------------------------------------------------------------
# APPLICATION
# -------------------------------------------------------------
NODE_ENV=development
APP_NAME=AI-Lab-SND
APP_VERSION=1.0.0
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=info

# -------------------------------------------------------------
# API SERVER (FastAPI)
# -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
API_SECRET_KEY=change-me-to-a-long-random-string
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------
# WEB DASHBOARD (React/Vite)
# -------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=AI Lab SND

# -------------------------------------------------------------
# DESKTOP APP (Electron)
# -------------------------------------------------------------
ELECTRON_DEV_URL=http://localhost:5173
ELECTRON_AUTO_UPDATE=true

# -------------------------------------------------------------
# DATABASE (PostgreSQL / SQLite)
# -------------------------------------------------------------
DATABASE_URL=sqlite:///./data/ailabsnd.db
# For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost:5432/ailabsnd
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# -------------------------------------------------------------
# REDIS (optional cache / queue)
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# -------------------------------------------------------------
# AUTHENTICATION / JWT
# -------------------------------------------------------------
JWT_SECRET=change-me-to-a-very-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# -------------------------------------------------------------
# AI / ML MODELS
# -------------------------------------------------------------
MODEL_PATH=./models
MODEL_FOOD_RECOGNITION=yolov8_food.pt
MODEL_NUTRITION_DB=nutrition5k.json
MODEL_CACHE_DIR=./.cache/models
MODEL_DEVICE=cpu
# Use "cuda" if you have an NVIDIA GPU, "mps" for Apple Silicon

# -------------------------------------------------------------
# OPENAI (optional — for AI meal suggestions)
# -------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

# -------------------------------------------------------------
# ESP32 FIRMWARE / IoT
# -------------------------------------------------------------
ESP32_MQTT_BROKER=mqtt://localhost:1883
ESP32_MQTT_USERNAME=ailabsnd
ESP32_MQTT_PASSWORD=change-me
ESP32_DEVICE_TOPIC=ailabsnd/devices
ESP32_OTA_URL=http://localhost:8000/firmware/latest

# -------------------------------------------------------------
# CLOUD SYNC (optional)
# -------------------------------------------------------------
CLOUD_SYNC_ENABLED=false
CLOUD_SYNC_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=ailabsnd-data

# -------------------------------------------------------------
# NUTRITION APIS (optional)
# -------------------------------------------------------------
USDA_API_KEY=your-usda-fdc-api-key
EDAMAM_APP_ID=
EDAMAM_APP_KEY=

# -------------------------------------------------------------
# EMAIL (for notifications / password reset)
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ailabsnd.local

# -------------------------------------------------------------
# TELEMETRY / ANALYTICS (optional)
# -------------------------------------------------------------
TELEMETRY_ENABLED=false
SENTRY_DSN=
POSTHOG_API_KEY=

# -------------------------------------------------------------
# DEVELOPMENT FLAGS
# -------------------------------------------------------------
DEBUG=true
HOT_RELOAD=true
MOCK_AI_RESPONSES=false